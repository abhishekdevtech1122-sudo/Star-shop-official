<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- 3D परछाई (हल्की और सोबर) -->
    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.1"/>
    </filter>
  </defs>
  
  <!-- एकदम साफ सफेद बैकग्राउंड -->
  <rect width="512" height="512" rx="110" fill="#FFFFFF" />
  
  <!-- कार्ट का डिज़ाइन (पीले रंग में) -->
  <g filter="url(#softShadow)" transform="translate(0, 15)">
    <!-- 1. स्पीड/मोशन लाइन्स (बाईं तरफ) -->
    <path d="M 75 220 H 195" fill="none" stroke="#FACC15" stroke-width="28" stroke-linecap="round"/>
    <path d="M 25 285 H 200" fill="none" stroke="#FACC15" stroke-width="28" stroke-linecap="round"/>
    
    <!-- 2. कार्ट का ऊपरी हैंडल -->
    <path d="M 50 85 L 100 85 L 115 155" fill="none" stroke="#FACC15" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"/>
    
    <!-- 3. कार्ट की मुख्य बॉडी/टोकरी (Basket & Frame) -->
    <path d="M 115 155 H 460 L 415 320 H 205 C 145 320 145 385 205 385 H 430" fill="none" stroke="#FACC15" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"/>
    
    <!-- 4. कार्ट के दोनों पहिए -->
    <circle cx="265" cy="445" r="30" fill="none" stroke="#FACC15" stroke-width="28" />
    <circle cx="395" cy="445" r="30" fill="none" stroke="#FACC15" stroke-width="28" />
  </g>
</svg>
